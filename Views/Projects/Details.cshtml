@model ProjectDetailsViewModel
@{
    ViewData["Title"] = Model.Project.Title;
}

<div class="py-5">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a href="@(Url.Action("Index", "Home"))#projects">Projects</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Project.Title</li>
        </ol>
    </nav>

    <!-- Project header -->
    <div class="row align-items-center g-4 mb-5">
        <div class="col-lg-7">
            <span class="badge bg-primary mb-3 px-3 py-2">@Model.Project.Category</span>
            <h1 class="fw-bold mb-3">@Model.Project.Title</h1>
            <p class="lead text-muted">@Model.Project.ShortDescription</p>
            <div class="mb-4">
                @foreach (var tag in Model.Project.Tags)
                {
                    <span class="badge bg-secondary">@tag</span>
                }
            </div>
            <a href="@Model.Project.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                <i class="bi bi-github me-2"></i>View on GitHub
            </a>
        </div>
        <div class="col-lg-5 text-center">
            <img src="@Model.Project.Thumbnail"
                 class="img-fluid rounded shadow-sm detail-thumb"
                 alt="Screenshot of @Model.Project.Title"
                 onerror="this.onerror=null; this.src='/images/briefing.png'; this.classList.add('thumb-placeholder');">
        </div>
    </div>

    <!-- Overview and features -->
    <div class="row g-4 mb-5">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-primary mb-3">Overview</h4>
                    <p class="lh-lg mb-0">@Model.Project.FullDescription</p>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-primary mb-3">Key Features</h4>
                    <ul class="mb-0 lh-lg">
                        @foreach (var feature in Model.Project.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Comment section -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h4 class="fw-bold text-primary mb-4">
                <i class="bi bi-chat-left-text me-2"></i>Comments (@Model.Comments.Count)
            </h4>

            @if (TempData["CommentPosted"] != null)
            {
                <div class="alert alert-success">@TempData["CommentPosted"]</div>
            }

            <form asp-controller="Projects" asp-action="AddComment" method="post" class="comment-form mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewComment.ProjectId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="NewComment.Author" class="form-label fw-semibold"></label>
                    <input asp-for="NewComment.Author" class="form-control" maxlength="40"
                           placeholder="e.g. Juan Dela Cruz" />
                    <span asp-validation-for="NewComment.Author" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewComment.Message" class="form-label fw-semibold"></label>
                    <textarea asp-for="NewComment.Message" class="form-control" rows="4" maxlength="500"
                              placeholder="Share your thoughts about this project..."></textarea>
                    <span asp-validation-for="NewComment.Message" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send me-2"></i>Post Comment
                </button>
            </form>

            @if (!Model.Comments.Any())
            {
                <p class="text-muted mb-0">No comments yet. Be the first to leave one.</p>
            }
            else
            {
                <div class="comment-list">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="comment-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@comment.Author</strong>
                                    <small class="text-muted ms-2">
                                        @comment.PostedAt.ToString("MMM d, yyyy h:mm tt")
                                    </small>
                                </div>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Projects" asp-action="DeleteComment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                            <p class="mb-0 mt-1 comment-text">@comment.Message</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
