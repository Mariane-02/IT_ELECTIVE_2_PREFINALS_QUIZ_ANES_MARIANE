                </li>
                <li class="mb-3">
                    <i class="bi bi-phone-fill text-primary me-2"></i>
                    <strong>Mobile:</strong> +63 963 842 1009
                </li>
                <li class="mb-3">
                    <i class="bi bi-github text-primary me-2"></i>
                    <strong>GitHub:</strong>
                    <a href="https://github.com/Mariane-02" target="_blank" class="text-decoration-none">github.com/Mariane-02</a>
                </li>
                <li class="mb-3">
                    <i class="bi bi-facebook text-primary me-2"></i>
                    <strong>Facebook:</strong>
                    <a href="https://www.facebook.com/mariane.anes.24/" target="_blank" class="text-decoration-none">facebook.com/mariane.anes.24</a>
                </li>
            </ul>
            <div class="mt-4">
                <a href="~/Anes, Mariane Valerie _ Resume.pdf" download="Anes_Resume.pdf" class="btn btn-success btn-lg">
                    <i class="bi bi-download me-2"></i>Download Resume
                </a>
            </div>
        </div>
    </div>
</section>
